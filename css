:root {
  --ink: #1b2a3a;
  --paper: #f4f6f8;
  --card: #ffffff;
  --line: #d5dce3;
  --accent: #0b6e8a;
  --pending: #b45309;
  --progress: #1d4ed8;
  --fixed: #15803d;
  --danger: #b91c1c;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font-family: "Segoe UI", Roboto, Arial, sans-serif; line-height: 1.5;
}
header { background: var(--ink); color: #fff; padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
header h1 { font-size: 1.1rem; margin: 0; }
header a { color: #cfe8f0; font-size: .9rem; }
main { max-width: 640px; margin: 24px auto; padding: 0 16px; }
main.wide { max-width: 1000px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 20px; }
label { display: block; font-weight: 600; margin: 14px 0 4px; }
input, select, textarea {
  width: 100%; padding: 10px; font: inherit; border: 1px solid var(--line); border-radius: 6px; background: #fff;
}
input:focus, select:focus, textarea:focus, button:focus-visible { outline: 3px solid #7cc4d8; outline-offset: 1px; }
textarea { min-height: 90px; resize: vertical; }
button {
  font: inherit; font-weight: 600; cursor: pointer; border: 0; border-radius: 6px;
  background: var(--accent); color: #fff; padding: 11px 18px; margin-top: 18px;
}
button:hover { filter: brightness(1.1); }
.msg { margin-top: 14px; font-weight: 600; }
.msg.ok { color: var(--fixed); }
.msg.err { color: var(--danger); }
.hint { color: #5b6b7a; font-size: .9rem; margin: 0 0 4px; }

/* dashboard */
.stats { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.stat { flex: 1 1 120px; background: var(--card); border: 1px solid var(--line); border-left-width: 6px; border-radius: 8px; padding: 10px 14px; }
.stat b { display: block; font-size: 1.6rem; }
.stat.pending { border-left-color: var(--pending); }
.stat.progress { border-left-color: var(--progress); }
.stat.fixed { border-left-color: var(--fixed); }
.filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.filters select { width: auto; min-width: 150px; }
.table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: 8px; }
table { width: 100%; border-collapse: collapse; min-width: 640px; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { background: #eaeff3; font-size: .9rem; }
td select { width: auto; padding: 6px; }
.badge { font-weight: 700; }
.badge.Pending { color: var(--pending); }
.badge.In-Progress { color: var(--progress); }
.badge.Fixed { color: var(--fixed); }
.empty { padding: 24px; text-align: center; color: #5b6b7a; }